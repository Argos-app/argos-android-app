<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StockRegistrationLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:textColor">@color/argos_green</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="StockRegistrationInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/screen_input_surface</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/argos_text_primary</item>
        <item name="android:textColorHint">@color/argos_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
    <style name="ThemeOverlay.Argos.StockRegistration" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Argos.StockRegistration</item>
        <item name="android:fontFamily">@font/dm_sans</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="Widget.Argos.StockRegistration" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/argos_background</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Argos.StockRegistration</item>
    </style>
    <style name="ShapeAppearance.Argos.StockRegistration">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">40dp</item>
        <item name="cornerSizeTopRight">40dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
