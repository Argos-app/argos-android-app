<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/application_add_sheet_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="100dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/argos_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/exceptions_create_title"
            android:textColor="@color/argos_green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/exceptions_origin_lot"
            android:textColor="@color/argos_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/exceptionOriginLotField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/application_field_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/exceptionOriginLotValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="@string/exceptions_origin_lot_hint"
                android:textColor="@color/argos_placeholder"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/exceptionOriginLotLoadingIndicator"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/applications_register_options_loading"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/argos_green"
                    app:indicatorSize="20dp"
                    app:trackThickness="2dp" />

                <ImageView
                    android:id="@+id/exceptionOriginLotErrorIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/error_icon"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/exceptionOriginLotDropdownIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/application_dropdown_icon"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/exceptions_reason_label"
            android:textColor="@color/argos_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/exceptionReasonField"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/application_field_background"
            android:fontFamily="@font/dm_sans"
            android:gravity="top|start"
            android:hint="@string/exceptions_reason_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minLines="3"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:textColor="#FF000000"
            android:textColorHint="@color/argos_placeholder"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/exceptions_ear_tag_label"
            android:textColor="@color/argos_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/exceptionEarTagField"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/application_field_background"
            android:fontFamily="@font/dm_sans"
            android:gravity="center_vertical"
            android:hint="@string/exceptions_ear_tag_hint"
            android:inputType="textCapCharacters"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="#FF000000"
            android:textColorHint="@color/argos_placeholder"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/exceptions_animal_weight"
            android:textColor="@color/argos_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/exceptionAnimalWeightField"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/application_field_background"
            android:fontFamily="@font/dm_sans"
            android:gravity="center_vertical"
            android:hint="@string/exceptions_animal_weight_hint"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="#FF000000"
            android:textColorHint="@color/argos_placeholder"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="42dp"
            android:layout_marginTop="28dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exceptionRegisterButton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/dm_sans"
                android:text="@string/exceptions_register"
                android:textAllCaps="false"
                android:textColor="@color/argos_background"
                android:textSize="15sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:backgroundTint="@color/argos_green"
                app:cornerRadius="28dp" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/exceptionRegisterLoadingIndicator"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/applications_register_submitting"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/argos_green"
                app:indicatorSize="20dp"
                app:trackThickness="2dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/exceptionLaterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="@string/applications_register_later"
            android:textColor="@color/argos_green"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
