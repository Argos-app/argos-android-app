<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="#FFFBFAF9"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#FFE3DCCF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exceptionEarTag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/argos_green"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Brinco: 075" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/exceptionStatusIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    tools:src="@drawable/positive_icon" />

                <TextView
                    android:id="@+id/exceptionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/dm_sans"
                    android:textColor="@color/argos_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Apto" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/exceptionLotName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/dm_sans"
            android:maxLines="1"
            android:textColor="@color/argos_text_secondary"
            android:textSize="11sp"
            tools:text="Lote atual: Sub Engorda 001" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#FFE3DCCF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/warning_icon" />

            <TextView
                android:id="@+id/exceptionReason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/dm_sans"
                android:maxLines="1"
                android:textColor="@color/argos_text_secondary"
                android:textSize="10sp"
                tools:text="Motivo: Animal com suspeita de febre aftosa." />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:text="Início:"
                android:textColor="@color/argos_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/exceptionStartDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/argos_green"
                android:textSize="10sp"
                tools:text="04/06/2026" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:text="Fim:"
                android:textColor="@color/argos_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/exceptionEndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/argos_green"
                android:textSize="10sp"
                tools:text="04/08/2026" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="Período para retorno"
                android:textColor="@color/argos_text_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/exceptionReturnProgressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans"
                android:textColor="@color/argos_green"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="60%" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/exceptionReturnProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="#FFE3DCCF"
            android:progressTint="@color/argos_nav_selected"
            tools:progress="60" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
