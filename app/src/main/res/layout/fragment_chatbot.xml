<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatbotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    tools:context=".view.fragment.ChatbotFragment">
    <LinearLayout
        android:id="@+id/chatbotMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/argos_background"
        android:orientation="vertical"
        android:paddingBottom="98dp">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:paddingHorizontal="20dp">
            <TextView
                android:id="@+id/chatbotTitle"
                android:translationY="8dp"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/dm_sans"
                android:text="@string/chatbot_title"
                android:textColor="@color/argos_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/chatbotTabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatbotNewTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/argos_green"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:id="@+id/chatbotNewTabLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:text="@string/chatbot_new_conversation"
                    android:textColor="@color/argos_background"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatbotHistoryTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/argos_background"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/argos_green"
                app:strokeWidth="1dp">
                <TextView
                    android:id="@+id/chatbotHistoryTabLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:text="@string/chatbot_history_tab"
                    android:textColor="@color/argos_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/chatbotLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/argos_accent"
            app:trackColor="@color/argos_loading_background" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chatbotErrorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/argos_loading_background"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/chatbotError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:textColor="@color/argos_text_primary"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/chatbotRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/chatbot_retry"
                    android:textColor="@color/argos_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/chatbotPageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</FrameLayout>
