<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatbotRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    tools:context=".view.fragment.ChatbotFragment">

    <LinearLayout
        android:id="@+id/chatbotMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/argos_background"
        android:orientation="vertical"
        android:paddingBottom="98dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:paddingHorizontal="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatbotBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical|start"
                android:clickable="true"
                android:contentDescription="@string/navigate_back"
                android:focusable="true"
                app:cardBackgroundColor="@color/argos_divider"
                app:cardCornerRadius="23dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/go_back" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/chatbotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/dm_sans"
                android:text="@string/chatbot_title"
                android:textColor="@color/argos_green"
                android:textSize="24sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatbotNewTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/argos_green"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/chatbotNewTabLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:text="@string/chatbot_new_conversation"
                    android:textColor="@color/argos_background"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chatbotHistoryTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/argos_background"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/argos_green"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/chatbotHistoryTabLabel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:text="@string/chatbot_history_tab"
                    android:textColor="@color/argos_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/chatbotContentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/chatbotContentScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingHorizontal="20dp">

                <LinearLayout
                    android:id="@+id/chatbotContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="20dp" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <TextView
            android:id="@+id/chatbotError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:gravity="center"
            android:textColor="@color/argos_notice_important"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatbotContinueAfterInterruption"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:minHeight="48dp"
            android:text="@string/chatbot_continue_after_interruption"
            android:textAllCaps="false"
            android:textColor="@color/argos_green"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/argos_background"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/argos_loading_track"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/chatbotInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/dm_sans"
                    android:hint="@string/chatbot_composer_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="2"
                    android:paddingVertical="8dp"
                    android:textColor="@color/argos_green"
                    android:textColorHint="@color/argos_green"
                    android:textSize="17sp" />

                <ImageButton
                    android:id="@+id/chatbotSend"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/chatbot_send_message"
                    android:padding="7dp"
                    android:src="@drawable/chat_send_icon"
                    android:tint="@color/argos_green" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/chatbotHelper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text="@string/chatbot_new_session_helper"
            android:textColor="@color/argos_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/chatbotOnboarding"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/argos_green"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.30"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/home_tobby_background" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/chatbotOnboardingBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="26dp"
            android:layout_marginTop="38dp"
            android:clickable="true"
            android:contentDescription="@string/navigate_back"
            android:focusable="true"
            app:cardBackgroundColor="@color/argos_divider"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="14dp"
                android:src="@drawable/go_back" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/chatbotOnboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginHorizontal="36dp"
            android:layout_marginTop="142dp"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text="@string/chatbot_onboarding_title"
            android:textColor="@color/argos_divider"
            android:textSize="25sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/chatbotMascot"
            android:layout_width="300dp"
            android:layout_height="370dp"
            android:layout_gravity="center"
            android:contentDescription="@string/home_mascot_description"
            android:scaleType="fitCenter"
            android:src="@drawable/tobby_home"
            android:translationY="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chatbotOnboardingCta"
            android:layout_width="256dp"
            android:layout_height="54dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="84dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/chatbot_onboarding_cta"
            android:textAllCaps="false"
            android:textColor="@color/argos_green"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/argos_divider"
            app:cornerRadius="28dp"
            android:insetBottom="0dp"
            android:insetTop="0dp" />
    </FrameLayout>
</FrameLayout>
