<?xml version='1.0' encoding='utf-8'?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/argos_background" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="24dp">
        <View android:layout_width="92dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:layout_marginBottom="20dp" android:background="@color/argos_divider" android:importantForAccessibility="no" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityHeading="true" android:text="@string/stock_registration_title" android:textColor="@color/argos_green" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:labelFor="@id/productInput" android:text="@string/stock_product_label" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="48dp">
            <EditText android:id="@+id/productInput" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:paddingEnd="44dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_product_hint" android:inputType="text" />
            <ProgressBar android:id="@+id/productLoadingIndicator" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp" android:indeterminateTint="@color/argos_green" android:visibility="gone" />
            <ImageView android:id="@+id/productDropdownIcon" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="end|center_vertical" android:layout_marginEnd="14dp" android:contentDescription="@null" android:importantForAccessibility="no" android:src="@drawable/application_dropdown_icon" />
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="14dp" android:labelFor="@id/batchNumberInput" android:text="@string/stock_batch_label" />
        <EditText android:id="@+id/batchNumberInput" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_batch_hint" android:inputType="textCapCharacters" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:labelFor="@id/quantityInput" android:text="@string/stock_quantity_label" />
                <EditText android:id="@+id/quantityInput" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_quantity_hint" android:inputType="numberDecimal" />
            </LinearLayout>
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:labelFor="@id/manufactureInput" android:text="@string/stock_manufacture_label" />
                <EditText android:id="@+id/manufactureInput" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_date_hint" android:inputType="none" android:focusable="false" android:clickable="true" android:drawableStart="@drawable/ic_stock_calendar" android:drawablePadding="6dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:labelFor="@id/registrationCodeInput" android:text="@string/stock_registration_code_label" />
                <EditText android:id="@+id/registrationCodeInput" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_registration_code_hint" android:inputType="none" android:focusable="false" android:clickable="false" />
            </LinearLayout>
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:labelFor="@id/expirationInput" android:text="@string/stock_expiration_label" />
                <EditText android:id="@+id/expirationInput" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_date_hint" android:inputType="none" android:focusable="false" android:clickable="true" android:drawableStart="@drawable/ic_stock_calendar" android:drawablePadding="6dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:labelFor="@id/supplierInput" android:text="@string/stock_supplier_label" />
                <EditText android:id="@+id/supplierInput" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_supplier_hint" android:inputType="textCapSentences" />
            </LinearLayout>
            <Space android:layout_width="16dp" android:layout_height="1dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:fontFamily="@font/dm_sans" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:labelFor="@id/cnpjInput" android:text="@string/stock_cnpj_label" />
                <EditText android:id="@+id/cnpjInput" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/screen_input_surface" android:fontFamily="@font/dm_sans" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/argos_text_primary" android:textColorHint="@color/argos_muted" android:textSize="12sp" android:importantForAutofill="no" android:hint="@string/stock_cnpj_hint" android:inputType="phone" android:maxLength="18" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/registerButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="24dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="@string/stock_register" android:textAllCaps="false" android:textColor="@color/argos_background" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@color/argos_green" app:cornerRadius="24dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/discardButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/stock_discard" android:textAllCaps="false" android:textColor="@color/argos_green" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

