<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/argos_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingBottom="38dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="110dp">
            <ImageButton android:id="@+id/backButton" android:layout_width="42dp" android:layout_height="42dp"
                android:layout_gravity="center_vertical|start" android:layout_marginStart="26dp" android:background="@drawable/screen_back_button" android:contentDescription="Voltar" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/go_back" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/argos_green" android:textSize="22sp" android:textStyle="bold" android:layout_gravity="center" android:text="Alterar senha" />
        </FrameLayout>
        <Space android:layout_width="1dp" android:layout_height="115dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/argos_green" android:textSize="32sp" android:textStyle="bold" android:gravity="center" android:text="Deseja alterar sua senha?" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:gravity="center" android:paddingHorizontal="25dp"
            android:text="Enviaremos um link para alterar sua senha&#10;ao e-mail cadastrado na sua conta:" android:textColor="@color/argos_green" android:textSize="16sp" android:lineSpacingExtra="2dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginStart="29dp" android:layout_marginEnd="29dp" android:layout_marginTop="26dp" android:background="@drawable/screen_input_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="19dp" android:paddingEnd="14dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/email_icon" />
            <EditText android:id="@+id/emailInput" android:layout_width="0dp" android:layout_height="match_parent" android:background="@null" android:singleLine="true" android:paddingStart="12dp" android:textColor="@color/argos_green" android:textColorHint="@color/argos_placeholder" android:textSize="15sp" android:layout_weight="1" android:hint="seuemail@dominio.com"
                android:inputType="textEmailAddress" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="29dp" android:layout_marginEnd="29dp" android:layout_marginTop="18dp"
            android:gravity="top" android:orientation="horizontal">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_marginTop="2dp"
                android:contentDescription="@null" android:src="@drawable/warning_icon" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="15dp" android:text="O link será enviado ao e-mail da sua conta. Caso não tenha acesso a ele, entre em contato com sua organização." android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" android:lineSpacingExtra="1dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/sendCodeButton" style="@style/Widget.Material3.Button" app:backgroundTint="@color/argos_green" app:cornerRadius="28dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginStart="36dp" android:layout_marginEnd="36dp" android:layout_marginTop="23dp"
            android:text="Enviar link" />
        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/argos_muted" android:textSize="11sp" android:paddingHorizontal="55dp" android:text="@string/reset_legal" />
    </LinearLayout>
</ScrollView>
