<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".view.fragment.HomeApplicationDetailsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:layout_marginTop="12dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/homeApplicationDetailsBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/screen_back_button_ripple"
            android:clickable="true"
            android:contentDescription="@string/navigate_back"
            android:focusable="true"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/go_back"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/home_application_details_title"
            android:textColor="@color/argos_green"
            android:textSize="22sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFBFAF9"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_application_details_application_section"
                    android:textColor="@color/argos_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/argos_divider" />

                <TextView
                    style="@style/HomeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_application_details_medicine_label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/homeApplicationDetailsMedicine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/argos_text_primary"
                    android:textSize="15sp"
                    tools:text="Vacina A" />

                <TextView
                    style="@style/HomeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_application_details_lot_label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/homeApplicationDetailsLot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/argos_text_primary"
                    android:textSize="15sp"
                    tools:text="Lote 1" />

                <TextView
                    style="@style/HomeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_application_details_application_date_label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/homeApplicationDetailsApplicationDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/argos_text_primary"
                    android:textSize="15sp"
                    tools:text="03/10/2026" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFBFAF9"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_application_details_withdrawal_section"
                    android:textColor="@color/argos_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/argos_divider" />

                <TextView
                    style="@style/HomeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_application_details_withdrawal_end_label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/homeApplicationDetailsWithdrawalEnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/argos_text_primary"
                    android:textSize="15sp"
                    tools:text="07/10/2026" />

                <TextView
                    style="@style/HomeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/home_application_details_days_remaining_label"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/homeApplicationDetailsDaysRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="15sp"
                    android:textColor="@color/argos_text_primary"
                    tools:text="4 dias" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
