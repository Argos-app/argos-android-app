<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    tools:context=".view.fragment.ExceptionsManagementFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="84dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/exceptionsBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:contentDescription="@string/navigate_back"
                android:focusable="true"
                android:translationY="8dp"
                app:cardBackgroundColor="@color/argos_icon"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:rippleColor="@color/argos_calendar_ripple"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/go_back" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/exceptionsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/dm_sans"
                android:gravity="center"
                android:text="@string/exceptions_title"
                android:textColor="@color/argos_green"
                android:textSize="20sp"
                android:textStyle="bold"
                android:translationY="8dp" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/exceptionsSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginHorizontal="20dp"
            app:cardBackgroundColor="@color/argos_background"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#FFE3DCCF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:text="@string/exceptions_total"
                        android:textColor="@color/argos_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/exceptionsTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/argos_green"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="18" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:background="#FFE3DCCF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:text="@string/exceptions_fit"
                        android:textColor="@color/argos_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/exceptionsFitCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/argos_accent"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="8" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:background="#FFE3DCCF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:text="@string/exceptions_unfit"
                        android:textColor="@color/argos_text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/exceptionsUnfitCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/dm_sans"
                        android:textColor="@color/argos_notice_important"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="10" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/exceptionsFilterContainer"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/argos_icon"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/exceptionsFilterIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/argos_nav_selected"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exceptionsFilterAll"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/exceptions_filter_all"
                    android:textSize="12sp"
                    android:textFontWeight="400" />

                <TextView
                    android:id="@+id/exceptionsFilterFit"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/exceptions_filter_fit"
                    android:textSize="12sp"
                    android:textFontWeight="400" />

                <TextView
                    android:id="@+id/exceptionsFilterUnfit"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/exceptions_filter_unfit"
                    android:textSize="12sp"
                    android:textFontWeight="400" />
            </LinearLayout>
        </FrameLayout>

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/exceptionsSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/exceptionsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="110dp"
                    android:scrollbars="none"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_exception" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/exceptionsLoadingIndicator"
                    style="@style/Widget.Material3.CircularProgressIndicator"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/exceptions_loading"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/argos_green"
                    app:indicatorSize="32dp"
                    app:trackColor="@color/argos_loading_track"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />

                <TextView
                    android:id="@+id/exceptionsStateMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:textColor="@color/argos_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:text="Nenhuma exceção encontrada." />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/exceptionsAddButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="48dp"
        android:clickable="true"
        android:contentDescription="@string/exceptions_add"
        android:focusable="true"
        app:cardBackgroundColor="@color/argos_green"
        app:cardCornerRadius="25dp"
        app:cardElevation="4dp"
        app:rippleColor="@color/argos_calendar_ripple"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/add_icon" />
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
