<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp">
        <ScrollView
            android:id="@+id/chatbotWelcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="20dp">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="26dp"
                    app:cardBackgroundColor="@color/argos_divider"
                    app:cardCornerRadius="42dp"
                    app:cardElevation="0dp">
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:src="@drawable/chat_tobby_icon"
                        android:scaleType="fitCenter"
                        android:contentDescription="@string/home_mascot_description" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/chatbot_welcome_heading"
                    android:textColor="@color/argos_green"
                    android:textSize="21sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/chatbot_welcome_subheading"
                    android:textColor="@color/argos_green"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/chatbot_suggestions_heading"
                    android:textColor="@color/argos_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/suggestHerd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/argos_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/argos_divider"
                    app:strokeWidth="1dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="14dp"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/chatbot_suggestion_herd"
                        android:textColor="@color/argos_green"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/suggestConsumption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/argos_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/argos_divider"
                    app:strokeWidth="1dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="14dp"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/chatbot_suggestion_consumption"
                        android:textColor="@color/argos_green"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/suggestMedicine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/argos_background"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/argos_divider"
                    app:strokeWidth="1dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="14dp"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/chatbot_suggestion_medication"
                        android:textColor="@color/argos_green"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/chatbotSending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/argos_accent"
        app:trackColor="@color/argos_loading_background" />
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/argos_background"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/argos_loading_track"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="10dp">
            <EditText
                android:id="@+id/chatbotInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/dm_sans"
                android:hint="@string/chatbot_composer_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="2"
                android:paddingVertical="8dp"
                android:textColor="@color/argos_green"
                android:textColorHint="@color/argos_green"
                android:textSize="17sp" />
            <ImageButton
                android:id="@+id/chatbotSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chatbot_send_message"
                android:padding="7dp"
                android:src="@drawable/chat_send_icon"
                android:tint="@color/argos_green" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:id="@+id/chatbotHelper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/dm_sans"
        android:gravity="center"
        android:text="@string/chatbot_new_session_helper"
        android:textColor="@color/argos_text_secondary"
        android:textSize="11sp" />
</LinearLayout>
