<?xml version="1.0" encoding="utf-8"?>
<com.android.argosapp.view.component.LotsManagementLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    android:clipChildren="false"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    tools:context=".view.fragment.LotsManagementFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="84dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lotsBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:contentDescription="@string/navigate_back"
                android:focusable="true"
                android:translationY="8dp"
                app:cardBackgroundColor="@color/argos_icon"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/go_back" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/dm_sans"
                android:gravity="center"
                android:text="@string/lots_title"
                android:textColor="@color/argos_green"
                android:textSize="20sp"
                android:textStyle="bold"
                android:translationY="8dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/lotsCarousel"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:clipChildren="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lotsIncomingCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="#285E49"
                app:cardCornerRadius="27dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lotsNextCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                app:cardBackgroundColor="#4E8065"
                app:cardCornerRadius="27dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="15dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="28dp">

                    <TextView
                        android:id="@+id/lotsNextSearchText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="36dp"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center_vertical"
                        android:text="@string/lots_search_hint"
                        android:textColor="@color/argos_background"
                        android:textSize="14sp" />

                    </FrameLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D7DFD8" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:translationY="-10dp">

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="48dp"
                            android:visibility="invisible"
                            android:gravity="center"
                            android:text="&lt;"
                            android:textColor="@color/argos_background"
                            android:textSize="36sp" />

                        <TextView
                            android:id="@+id/lotsNextTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center"
                            android:maxLines="1"
                            android:textColor="@color/argos_background"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="48dp"
                            android:visibility="invisible"
                            android:gravity="center"
                            android:text="&gt;"
                            android:textColor="@color/argos_background"
                            android:textSize="36sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lotsHeroCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                app:cardBackgroundColor="@color/argos_nav_selected"
                app:cardCornerRadius="27dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="15dp">

                    <LinearLayout
                        android:id="@+id/lotsEmptyHeader"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        tools:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/dm_sans"
                            android:text="@string/lots_overview"
                            android:textColor="@color/argos_background"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="7dp"
                            android:background="#D7DFD8" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="25dp"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center"
                            android:text="@string/lots_no_active"
                            android:textColor="@color/argos_background"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/dm_sans"
                            android:text="@string/lots_empty_description"
                            android:textColor="@color/argos_background"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lotsPopulatedHeader"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="28dp">

                            <EditText
                                android:id="@+id/lotsSearchInput"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="36dp"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/dm_sans"
                                android:hint="@string/lots_search_hint"
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:maxLines="1"
                                android:padding="0dp"
                                android:textColor="@color/argos_background"
                                android:textColorHint="@color/argos_background"
                                android:textSize="14sp" />

                        </FrameLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#D7DFD8" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:translationY="-10dp">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="48dp"
                                android:visibility="invisible"
                                android:gravity="center"
                                android:text="‹"
                                android:textColor="@color/argos_background"
                                android:textSize="36sp" />

                            <TextView
                                android:id="@+id/lotsTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/dm_sans"
                                android:gravity="center"
                                android:maxLines="1"
                                android:textColor="@color/argos_background"
                                android:textSize="27sp"
                                android:textStyle="bold"
                                tools:text="Lote Engorda" />

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="48dp"
                                android:visibility="invisible"
                                android:gravity="center"
                                android:text="›"
                                android:textColor="@color/argos_background"
                                android:textSize="36sp" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/lotsSearchButton"
                android:layout_width="32dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="20dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/lots_search"
                android:elevation="8dp"
                android:padding="8dp"
                android:src="@drawable/search_icon"
                android:tint="@android:color/white"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/lotsPrevious"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="38dp"
                android:contentDescription="@string/lots_previous"
                android:elevation="8dp"
                android:gravity="center"
                android:text="&lt;"
                android:textColor="@color/argos_background"
                android:textSize="36sp"
                android:translationY="12dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/lotsNext"
                android:layout_width="36dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="20dp"
                android:contentDescription="@string/lots_next"
                android:elevation="8dp"
                android:gravity="center"
                android:text="&gt;"
                android:textColor="@color/argos_background"
                android:textSize="36sp"
                android:translationY="12dp"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/lotsFilterContainer"
            android:layout_width="156dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/argos_icon"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lotsFilterIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/argos_nav_selected"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lotsFilterAll"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/lots_filter_all"
                    android:textColor="@color/argos_background"
                    android:textFontWeight="400"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lotsFilterSlaughter"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/lots_filter_slaughter"
                    android:textFontWeight="400"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/lotsSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lotsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="96dp"
                    android:scrollbars="none"
                    android:visibility="gone"
                    tools:itemCount="1"
                    tools:visibility="visible" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/lotsSlaughterCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="26dp"
                    android:layout_marginTop="32dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FAFAFA"
                    app:cardCornerRadius="38dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#BFA36D"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="22dp"
                        android:paddingTop="32dp"
                        android:paddingBottom="20dp">

                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="88dp"
                            android:contentDescription="@null"
                            android:src="@drawable/tri_warn_icon" />

                        <TextView
                            android:id="@+id/lotsSlaughterTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center"
                            android:textColor="@color/argos_notice_important"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Abate indisponível para Lote Engorda" />

                        <TextView
                            android:id="@+id/lotsSlaughterMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center"
                            android:textColor="@color/argos_notice_important"
                            android:textSize="14sp"
                            tools:text="Em carência. Liberação em 04/08/2026." />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lotsSlaughterButton"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/dm_sans"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/lots_register_slaughter"
                            android:textAllCaps="false"
                            android:textColor="@color/argos_notice_important"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@android:color/transparent"
                            app:cornerRadius="24dp"
                            app:strokeColor="@color/argos_notice_important"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/lotsStateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:paddingBottom="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/lotsStateImageCard"
                        android:layout_width="196dp"
                        android:layout_height="164dp"
                        android:layout_marginTop="56dp"
                        app:cardBackgroundColor="#F1E5C9"
                        app:cardCornerRadius="19dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/empty_lots_ilustration" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/lotsStateMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:text="@string/lots_empty"
                        android:textColor="@color/argos_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/lotsEmptyAddButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="64dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/lots_empty_add"
                        android:textAllCaps="false"
                        android:textColor="@color/argos_background"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        app:backgroundTint="@color/argos_green"
                        app:cornerRadius="26dp" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/lotsLoadingIndicator"
                    style="@style/Widget.Material3.CircularProgressIndicator"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/lots_loading"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/argos_green"
                    app:indicatorSize="48dp"
                    app:trackColor="@color/argos_loading_track" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lotsAddButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="42dp"
        android:clickable="true"
        android:contentDescription="@string/lots_add"
        android:focusable="true"
        android:visibility="gone"
        app:cardBackgroundColor="@color/argos_green"
        app:cardCornerRadius="24dp"
        app:cardElevation="3dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/add_icon" />
    </com.google.android.material.card.MaterialCardView>
</com.android.argosapp.view.component.LotsManagementLayout>
