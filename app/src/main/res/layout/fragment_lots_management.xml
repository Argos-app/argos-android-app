<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    tools:context=".view.fragment.LotsManagementFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="84dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lotsBackButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="16dp"
                android:clickable="true"
                android:contentDescription="@string/navigate_back"
                android:focusable="true"
                android:translationY="8dp"
                app:cardBackgroundColor="@color/argos_icon"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:rippleColor="@color/argos_calendar_ripple"
                app:strokeWidth="0dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/go_back" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:translationY="8dp">

                <TextView
                    android:id="@+id/lotsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/lots_title"
                    android:textColor="@color/argos_green"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="20dp"
            app:cardBackgroundColor="#FFFBFAF9"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/lotsSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="38dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/dm_sans"
                    android:hint="@string/lots_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/argos_green"
                    android:textColorHint="#FFC2B59B"
                    android:textFontWeight="400"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/lotsSearchButton"
                    android:layout_width="36dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/lots_search"
                    android:padding="8dp"
                    android:src="@drawable/search_icon"
                    android:tint="#FFC2B59B" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/lotsFilterContainer"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardBackgroundColor="@color/argos_icon"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/lotsFilterIndicator"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:cardBackgroundColor="@color/argos_nav_selected"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lotsFilterAll"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/lots_filter_all"
                    android:textFontWeight="400"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lotsFilterEngorda"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/lots_filter_engorda"
                    android:textFontWeight="400"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/lotsFilterRecria"
                    style="@style/ApplicationsFilterTab"
                    android:text="@string/lots_filter_recria"
                    android:textFontWeight="400"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/lotsSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lotsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="110dp"
                    android:scrollbars="none"
                    tools:itemCount="3" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/lotsLoadingIndicator"
                    style="@style/Widget.Material3.CircularProgressIndicator"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/lots_loading"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/argos_green"
                    app:indicatorSize="48dp"
                    app:trackColor="@color/argos_loading_track"
                    app:trackCornerRadius="2dp"
                    app:trackThickness="4dp" />

                <LinearLayout
                    android:id="@+id/lotsStateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:translationY="-40dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="240dp"
                        android:layout_height="200dp"
                        app:cardBackgroundColor="@color/argos_background"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/argos_border"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/lotsStateImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/empty_lots_ilustration"
                            tools:ignore="ContentDescription" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/lotsStateMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/dm_sans"
                        android:gravity="center"
                        android:text="@string/lots_empty"
                        android:textColor="@color/argos_text_secondary"
                        android:textSize="14sp"
                        tools:text="Nenhum lote encontrado." />

                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/lotsAddButton"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="48dp"
        android:clickable="true"
        android:contentDescription="@string/lots_add"
        android:focusable="true"
        app:cardBackgroundColor="@color/argos_green"
        app:cardCornerRadius="25dp"
        app:cardElevation="4dp"
        app:rippleColor="@color/argos_calendar_ripple"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/add_icon" />
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>