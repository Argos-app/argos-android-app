<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    tools:context=".view.fragment.ProfileFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:background="@color/argos_green">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="223dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/home_tobby_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="45dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:id="@+id/profileUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/argos_background"
                android:textSize="20sp"
                tools:text="Vinícius de Oliveira" />

            <TextView
                android:id="@+id/profileFarmName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/argos_background"
                android:textSize="13sp"
                tools:text="Funcionário da fazenda Coração de Luz" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <Space
                android:layout_width="match_parent"
                android:layout_height="300dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/profileOptionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                app:cardBackgroundColor="#FFFBFAF9"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="19dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <FrameLayout
                        android:id="@+id/profileEditOption"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:paddingHorizontal="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            app:cardBackgroundColor="@color/argos_green"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/edit_profile_icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="50dp"
                            android:layout_marginEnd="28dp"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center_vertical"
                            android:text="@string/profile_edit"
                            android:textColor="@color/argos_green"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center_vertical|end"
                            android:contentDescription="@null"
                            android:src="@drawable/enter_icon" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_marginRight="4dp"
                        android:paddingHorizontal="12dp"
                        android:id="@+id/profileNotificationsOption"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            app:cardBackgroundColor="@color/argos_green"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="17dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/notification_icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="50dp"
                            android:layout_marginEnd="28dp"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center_vertical"
                            android:text="@string/profile_notifications"
                            android:textColor="@color/argos_green"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center_vertical|end"
                            android:contentDescription="@null"
                            android:src="@drawable/enter_icon" />
                    </FrameLayout>

                    <FrameLayout
                        android:paddingHorizontal="12dp"
                        android:layout_marginRight="4dp"
                        android:id="@+id/profileAddressOption"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            app:cardBackgroundColor="@color/argos_green"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/verify_address_icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="50dp"
                            android:layout_marginEnd="28dp"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center_vertical"
                            android:text="@string/profile_verify_address"
                            android:textColor="@color/argos_green"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center_vertical|end"
                            android:contentDescription="@null"
                            android:src="@drawable/enter_icon" />
                    </FrameLayout>

                    <FrameLayout
                        android:paddingHorizontal="12dp"
                        android:layout_marginRight="4dp"
                        android:id="@+id/profileChangePasswordOption"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center_vertical|start"
                            app:cardBackgroundColor="@color/argos_green"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/change_password_icon" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="50dp"
                            android:layout_marginEnd="28dp"
                            android:fontFamily="@font/dm_sans"
                            android:gravity="center_vertical"
                            android:text="@string/profile_change_password"
                            android:textColor="@color/argos_green"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center_vertical|end"
                            android:contentDescription="@null"
                            android:src="@drawable/enter_icon" />
                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/profileLogoutButton"
                        android:layout_width="200dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/dm_sans"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginBottom="10dp"
                        android:text="@string/profile_logout"
                        android:textAllCaps="false"
                        android:textColor="@color/argos_background"
                        android:textSize="18sp"
                        app:backgroundTint="@color/argos_green"
                        app:cornerRadius="25dp"
                        app:icon="@drawable/logout_icon"
                        app:iconGravity="textStart"
                        android:textStyle="bold"
                        app:iconPadding="8dp"
                        app:iconSize="17dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
