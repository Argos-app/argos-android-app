<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/argos_background">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="23dp" android:paddingEnd="23dp"
            android:paddingTop="28dp" android:paddingBottom="28dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal" android:orientation="vertical">
            <ImageView android:id="@+id/authLogo" android:layout_width="260dp" android:layout_height="62dp"
                android:contentDescription="@string/app_name" android:scaleType="fitCenter" android:src="@drawable/argos_horizontal_logo" />
            <TextView android:id="@+id/authSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:gravity="center" android:textColor="@android:color/black" android:textSize="14sp" />
        </LinearLayout>
            <Space android:layout_width="1dp" android:layout_height="28dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/argos_green" android:textSize="14sp" android:textStyle="bold" android:layout_marginStart="8dp" android:text="Nova senha" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/screen_input_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="19dp" android:paddingEnd="8dp" android:layout_marginTop="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/lock_icon" />
                <EditText android:id="@+id/newPasswordInput" android:layout_width="0dp" android:layout_height="match_parent" android:background="@null" android:singleLine="true" android:paddingStart="12dp" android:textColor="@color/argos_green" android:textColorHint="@color/argos_placeholder" android:textSize="15sp" android:layout_weight="1" android:hint="senhadeacesso"
                    android:inputType="textPassword" />
                <ImageButton android:id="@+id/newPasswordVisibilityButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Mostrar senha" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/closed_eye_icon" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:layout_marginTop="18dp" android:textColor="@color/argos_green" android:textSize="14sp" android:textStyle="bold" android:text="Confirme a nova senha" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:background="@drawable/screen_input_surface" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="19dp" android:paddingEnd="8dp" android:layout_marginTop="8dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/lock_icon" />
                <EditText android:id="@+id/passwordConfirmationInput" android:layout_width="0dp" android:layout_height="match_parent" android:background="@null" android:singleLine="true" android:paddingStart="12dp" android:textColor="@color/argos_green" android:textColorHint="@color/argos_placeholder" android:textSize="15sp" android:layout_weight="1" android:hint="senhadeacesso"
                    android:inputType="textPassword" />
                <ImageButton android:id="@+id/passwordConfirmationVisibilityButton" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Mostrar senha" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/closed_eye_icon" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="9dp" android:layout_marginTop="12dp"
                android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="Para sua segurança, a senha deve conter:" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:text="Mínimo de 8 caracteres" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/criteriaLengthIcon" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:contentDescription="@string/password_criterion_pending" android:src="@drawable/negative_icon" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:text="Pelo menos uma letra maiúscula" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/criteriaCapitalIcon" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:contentDescription="@string/password_criterion_pending" android:src="@drawable/negative_icon" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:text="Pelo menos uma letra minúscula" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/criteriaLowercaseIcon" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:contentDescription="@string/password_criterion_pending" android:src="@drawable/negative_icon" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:text="Pelo menos um número" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/criteriaNumericIcon" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:contentDescription="@string/password_criterion_pending" android:src="@drawable/negative_icon" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="5dp" android:text="Pelo menos um caractere especial (@ ! # $ % &amp;)" android:textColor="@color/argos_green" android:textSize="11sp" android:textStyle="bold" />
                    <ImageView android:id="@+id/criteriaSpecialIcon" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:contentDescription="@string/password_criterion_pending" android:src="@drawable/negative_icon" />
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/changePasswordButton" style="@style/Widget.Material3.Button" app:backgroundTint="@color/argos_green" app:cornerRadius="28dp" android:insetTop="0dp" android:insetBottom="0dp" android:minHeight="0dp" android:stateListAnimator="@null" android:textAllCaps="false" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginStart="5dp" android:layout_marginEnd="5dp" android:layout_marginTop="26dp"
                android:text="Alterar Senha" />
            <TextView android:id="@+id/backToLoginLink" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center" android:text="Voltar para tela de login" android:textColor="@color/argos_green" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:id="@+id/loadingOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/argos_loading_background" android:clickable="true" android:focusable="true" android:visibility="gone">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:gravity="center" android:orientation="vertical">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                style="@style/Widget.Material3.CircularProgressIndicator"
                android:layout_width="88dp" android:layout_height="88dp" android:contentDescription="Carregando"
                android:indeterminate="true" app:indicatorSize="88dp" app:trackThickness="8dp"
                app:trackCornerRadius="4dp" app:indicatorColor="@color/argos_green" app:trackColor="@color/argos_loading_track" />
            <TextView android:id="@+id/loadingMessage" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:textColor="@color/argos_green" android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
