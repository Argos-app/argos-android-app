<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeContentScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".view.fragment.HomeFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="284dp"
            android:background="@color/argos_green" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="223dp"
            android:layout_gravity="top"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/home_tobby_background" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="268dp">

            <View
                android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginHorizontal="20dp"
                android:background="@color/argos_background" />

            <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="@color/argos_background"
            app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp" />

            <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
                android:layout_gravity="top|end"
                android:stateListAnimator="@null"
                app:cardBackgroundColor="@color/argos_background"
            app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:strokeWidth="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
                android:background="@color/argos_background"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
            android:paddingTop="36dp"
                android:paddingBottom="120dp">

                <TextView
                    android:id="@+id/homeGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_greeting_fallback"
                    android:textColor="@color/argos_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Olá, Vinícius. Que bom te ver!" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/home_herd_health"
                    android:textColor="@color/argos_text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="32dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="32dp"
                    android:background="#FFE2DCCF" />

                <TextView
                    style="@style/HomeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_choose_action" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="26dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFFBFAF9"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:contentDescription="@null"
                                android:src="@drawable/pill_icon" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/home_manage_medication"
                                android:textColor="@color/argos_text_primary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFFBFAF9"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:contentDescription="@null"
                                android:src="@drawable/syringe" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/home_manage_applications"
                                android:textColor="@color/argos_text_primary"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    style="@style/HomeSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/home_calendar_section" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FFE2DBCE"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp">

                        <TextView
                            android:id="@+id/homeCalendarMonth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:textColor="@color/argos_green"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="Junho, 2026" />

                        <GridLayout
                            android:id="@+id/homeCalendarGrid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:columnCount="7"
                            android:orientation="horizontal"
                            android:rowCount="7">

                            <TextView
                                style="@style/HomeCalendarWeekday"
                                android:text="D" />

                            <TextView
                                style="@style/HomeCalendarWeekday"
                                android:text="S" />

                            <TextView
                                style="@style/HomeCalendarWeekday"
                                android:text="T" />

                            <TextView
                                style="@style/HomeCalendarWeekday"
                                android:text="Q" />

                            <TextView
                                style="@style/HomeCalendarWeekday"
                                android:text="Q" />

                            <TextView
                                style="@style/HomeCalendarWeekday"
                                android:text="S" />

                            <TextView
                                style="@style/HomeCalendarWeekday"
                                android:text="S" />
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/homeSelectedDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:textColor="@color/argos_green"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="23 de Junho de 2026" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="#FFFBFAF9"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FFFBFAF9"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="7dp"
                                android:gravity="center_vertical"
                                android:text="@string/home_vaccine_event"
                                android:textColor="@color/argos_green"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginBottom="5dp"
                                android:background="#FFE9E5DC" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.85"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/home_vaccine_detail"
                                    android:textColor="@color/argos_muted"
                                    android:textSize="9sp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1.15"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:text="@string/home_application_date"
                                    android:textColor="@color/argos_muted"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="@color/argos_green"
                        android:importantForAccessibility="no"
                        />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="#FFFBFAF9"
                        android:importantForAccessibility="no" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#FFFBFAF9"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:text="@string/home_waiting_period_event"
                                android:textColor="#FF715849"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginBottom="5dp"
                                android:background="#FFE9E5DC" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.85"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/home_waiting_period_detail"
                                    android:textColor="@color/argos_muted"
                                    android:textSize="9sp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1.15"
                                    android:ellipsize="end"
                                    android:gravity="end"
                                    android:maxLines="1"
                                    android:text="@string/home_application_date"
                                    android:textColor="@color/argos_muted"
                                    android:textSize="9sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="#FF3F1A08"
                        android:importantForAccessibility="no"
                        />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:layout_width="365dp"
            android:layout_height="365dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="13dp"
            android:contentDescription="@string/home_mascot_description"
            android:scaleType="fitCenter"
            android:src="@drawable/tobby_home"
            android:translationX="-3dp" />
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
