<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/application_add_sheet_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="100dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/argos_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/applications_register_title"
            android:textColor="@color/argos_green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/applications_register_exception_lot"
            android:textColor="@color/argos_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/applicationLotField"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/application_field_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="@string/applications_register_lot_hint"
                android:textColor="@color/argos_placeholder"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/application_dropdown_icon" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/applications_register_medicine"
            android:textColor="@color/argos_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/applicationMedicineField"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/application_field_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/dm_sans"
                android:text="@string/applications_register_medicine_hint"
                android:textColor="@color/argos_placeholder"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/application_dropdown_icon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/applications_register_date"
                    android:textColor="@color/argos_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/applicationDateField"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/application_field_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/application_calendar_icon" />

                    <TextView
                        android:id="@+id/applicationDateValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/dm_sans"
                        android:text="@string/applications_register_date_hint"
                        android:textColor="#FF000000"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/dm_sans"
                    android:text="@string/applications_register_ear_tag"
                    android:textColor="@color/argos_green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/applicationEarTagField"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/application_field_background"
                    android:fontFamily="@font/dm_sans"
                    android:gravity="center_vertical"
                    android:hint="@string/applications_register_ear_tag_hint"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="#FF000000"
                    android:textColorHint="@color/argos_placeholder"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/applications_register_dose"
            android:textColor="@color/argos_green"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/applicationDoseField"
            android:layout_width="150dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/application_field_background"
            android:fontFamily="@font/dm_sans"
            android:gravity="center_vertical"
            android:hint="@string/applications_register_dose_hint"
            android:inputType="number"
            android:maxLines="1"
            android:paddingHorizontal="14dp"
            android:textColor="#FF000000"
            android:textColorHint="@color/argos_placeholder"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applicationRegisterButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="42dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/dm_sans"
            android:text="@string/applications_register_submit"
            android:textAllCaps="false"
            android:textColor="@color/argos_background"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/argos_green"
            app:cornerRadius="28dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:id="@+id/applicationLaterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="@string/applications_register_later"
            android:textColor="@color/argos_green"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
