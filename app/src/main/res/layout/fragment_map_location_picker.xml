<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/argos_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="10dp">

        <ImageButton
            android:id="@+id/locationPickerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:background="@drawable/screen_back_button_ripple"
            android:contentDescription="@string/navigate_back"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/go_back"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text="@string/profile_location_picker_title"
            android:textColor="@color/argos_green"
            android:textSize="22sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/locationPickerMap"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/address_location_pin_icon"
            android:translationY="-18dp" />

        <FrameLayout
            android:id="@+id/locationPickerCurrentLocation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="112dp"
            android:elevation="6dp">

            <ImageButton
                android:id="@+id/locationPickerCurrentLocationIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/screen_input_surface"
                android:contentDescription="@string/profile_location_picker_current_location"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/my_location_icon"
                android:stateListAnimator="@null" />

            <ProgressBar
                android:id="@+id/locationPickerCurrentLocationProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/argos_green"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/locationPickerSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="top"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/screen_input_surface"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <EditText
                android:id="@+id/locationPickerSearchQuery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/dm_sans"
                android:hint="@string/profile_location_picker_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textPostalAddress|textCapSentences"
                android:singleLine="true"
                android:textColor="@color/argos_text_primary"
                android:textColorHint="@color/argos_placeholder"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationPickerSearchButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:fontFamily="@font/dm_sans"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/profile_location_picker_search_action"
                android:textAllCaps="false"
                android:textColor="@color/argos_background"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/argos_green"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/locationPickerSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="74dp"
            android:background="@drawable/screen_input_surface"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/argos_background"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans"
            android:gravity="center"
            android:text="@string/profile_location_picker_instruction"
            android:textColor="@color/argos_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/locationPickerSelectedAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/screen_input_surface"
            android:enabled="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <ProgressBar
                android:id="@+id/locationPickerAddressProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:indeterminateTint="@color/argos_green"
                android:visibility="visible" />

            <TextView
                android:id="@+id/locationPickerSelectedAddressText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/dm_sans"
                android:maxLines="2"
                android:text="@string/profile_location_picker_address_loading"
                android:textColor="@color/argos_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationPickerConfirm"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/dm_sans"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:text="@string/profile_location_picker_confirm"
                android:textAllCaps="false"
                android:textColor="@color/argos_background"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/argos_green"
                app:cornerRadius="24dp" />

            <ProgressBar
                android:id="@+id/locationPickerProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/argos_background"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
